FROM node:22.17.0-bookworm-slim AS build
WORKDIR /opt/trace/apps/web
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci
COPY apps/web/src src
COPY apps/web/index.html apps/web/tsconfig.json apps/web/vite.config.ts ./
COPY packages/contracts/generated /opt/trace/packages/contracts/generated
RUN npm run build
FROM nginx:1.28.0-alpine
COPY --from=build /opt/trace/apps/web/dist /usr/share/nginx/html
COPY infra/nginx.p1.conf /etc/nginx/nginx.conf
USER 101:101
ENTRYPOINT ["nginx", "-g", "daemon off;"]
