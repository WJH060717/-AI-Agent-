APP_ENV=development
APP_BIND=127.0.0.1
APP_PORT=8000
# Optional production UI; use only the frozen, trusted build directory.
# WEB_DIST=apps/web/dist
RAW_STORE=data/raw
STAGING_STORE=data/staging
MAX_UPLOAD_MB=100
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=10
WORKER_MAX_ATTEMPTS=3
WORKER_POLL_SECONDS=1
IMPORT_CHUNK_LINES=500
SNAPSHOT_EVENT_LIMIT=250
DETECTION_EVENT_LIMIT=100000
DETECTION_BYTE_LIMIT=268435456
DETECTION_WORK_LIMIT=2000000
DETECTION_TIMEOUT_SECONDS=20
DETECTION_FINDING_LIMIT=2000
DETECTION_REFERENCE_LIMIT=500000
MODEL_PROVIDER=disabled
MODEL_TIMEOUT_SECONDS=20
TOOL_TIMEOUT_SECONDS=3
MODEL_OUTPUT_TOKENS_PER_CALL=768
MODEL_TEST_STUB=false
# Optional compatible-provider extension; omitted by default. DeepSeek initial trial:
# MODEL_THINKING=disabled
MODEL_PLAN_FACT_LIMIT=1
# USD per million tokens: supply your approved provider prices and effective date/version.
# MODEL_INPUT_USD_PER_MILLION=1.0
# MODEL_OUTPUT_USD_PER_MILLION=2.0
MODEL_PRICE_VERSION=unconfigured
# Micro-USD cap: 100000 = USD 0.10; default zero blocks paid calls.
AGENT_MAX_COST_MICROUSD=0
REPORT_EXPORT_MAX_LINES=5000
REPORT_EXPORT_MAX_BYTES=5000000
# Configure before migration/API business calls:
# DATABASE_URL=postgresql+psycopg://trace_app:<password>@127.0.0.1:5432/trace
# Enable all three together only with authorized, redacted lab data:
# MODEL_BASE_URL=https://your-approved-endpoint.example/v1
# MODEL_NAME=your-pinned-model
# MODEL_API_KEY=replace-locally

# Single API process quotas, per authenticated identity; reset on restart.
API_READ_REQUESTS_PER_MINUTE=120
API_WRITE_REQUESTS_PER_MINUTE=20
API_RATE_MAX_IDENTITIES=1024
## Offline backup: optional PostgreSQL 16 binaries folder; never put credentials here.
# BACKUP_PG_BIN=C:/path/to/pgsql/bin
BACKUP_TIMEOUT_SECONDS=600
KNOWLEDGE_ENABLED=true
REPLAY_EVENT_LIMIT=100000
REPLAY_BATCH_SIZE=500
